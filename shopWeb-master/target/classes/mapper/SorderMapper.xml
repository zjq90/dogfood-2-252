<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.mapper.SorderMapper">
    
    <!-- 订单项实体结果映射 -->
    <resultMap id="BaseResultMap" type="com.shop.entity.Sorder">
        <id column="sid" jdbcType="INTEGER" property="sid"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="price" jdbcType="DOUBLE" property="price"/>
        <result column="number" jdbcType="INTEGER" property="number"/>
        <result column="fid" jdbcType="INTEGER" property="fid"/>
        <result column="pid" jdbcType="INTEGER" property="pid"/>
    </resultMap>

    <!-- 订单项关联商品的结果映射 -->
    <resultMap id="SorderWithProductResultMap" type="com.shop.entity.Sorder" extends="BaseResultMap">
        <association property="product" javaType="com.shop.entity.Product">
            <id column="p_pid" property="pid"/>
            <result column="p_pname" property="pname"/>
            <result column="p_cprice" property="cprice"/>
            <result column="p_pic" property="pic"/>
        </association>
    </resultMap>

    <!-- 基础列名列表 -->
    <sql id="Base_Column_List">
        sid, name, price, number, fid, pid
    </sql>

    <!-- 根据主键查询订单项 -->
    <select id="selectByPrimaryKey" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM zk_sorder
        WHERE sid = #{sid,jdbcType=INTEGER}
    </select>

    <!-- 根据订单ID查询订单项列表（关联商品信息） -->
    <select id="listSorderByFid" parameterType="java.lang.Integer" resultMap="SorderWithProductResultMap">
        SELECT s.sid, s.name, s.price, s.number, s.fid, s.pid,
               p.pid as p_pid, p.pname as p_pname, p.cprice as p_cprice, p.pic as p_pic
        FROM zk_sorder s
        LEFT JOIN zk_product p ON s.pid = p.pid
        WHERE s.fid = #{fid,jdbcType=INTEGER}
    </select>

    <!-- 根据主键删除订单项 -->
    <delete id="deleteByPrimaryKey" parameterType="java.lang.Integer">
        DELETE FROM zk_sorder
        WHERE sid = #{sid,jdbcType=INTEGER}
    </delete>

    <!-- 根据订单ID删除所有订单项 -->
    <delete id="deleteByFid" parameterType="java.lang.Integer">
        DELETE FROM zk_sorder
        WHERE fid = #{fid,jdbcType=INTEGER}
    </delete>

    <!-- 插入订单项（全字段） -->
    <insert id="insert" parameterType="com.shop.entity.Sorder">
        INSERT INTO zk_sorder (name, price, number, fid, pid)
        VALUES (#{name,jdbcType=VARCHAR}, #{price,jdbcType=DOUBLE}, #{number,jdbcType=INTEGER},
                #{fid,jdbcType=INTEGER}, #{pid,jdbcType=INTEGER})
    </insert>

    <!-- 选择性插入订单项（仅插入非空字段） -->
    <insert id="insertSelective" parameterType="com.shop.entity.Sorder">
        INSERT INTO zk_sorder
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sid != null">sid,</if>
            <if test="name != null">name,</if>
            <if test="price != null">price,</if>
            <if test="number != null">number,</if>
            <if test="fid != null">fid,</if>
            <if test="pid != null">pid,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="sid != null">#{sid,jdbcType=INTEGER},</if>
            <if test="name != null">#{name,jdbcType=VARCHAR},</if>
            <if test="price != null">#{price,jdbcType=DOUBLE},</if>
            <if test="number != null">#{number,jdbcType=INTEGER},</if>
            <if test="fid != null">#{fid,jdbcType=INTEGER},</if>
            <if test="pid != null">#{pid,jdbcType=INTEGER},</if>
        </trim>
    </insert>

    <!-- 选择性更新订单项（仅更新非空字段） -->
    <update id="updateByPrimaryKeySelective" parameterType="com.shop.entity.Sorder">
        UPDATE zk_sorder
        <set>
            <if test="name != null">name = #{name,jdbcType=VARCHAR},</if>
            <if test="price != null">price = #{price,jdbcType=DOUBLE},</if>
            <if test="number != null">number = #{number,jdbcType=INTEGER},</if>
            <if test="fid != null">fid = #{fid,jdbcType=INTEGER},</if>
            <if test="pid != null">pid = #{pid,jdbcType=INTEGER},</if>
        </set>
        WHERE sid = #{sid,jdbcType=INTEGER}
    </update>

    <!-- 根据主键更新订单项（全字段） -->
    <update id="updateByPrimaryKey" parameterType="com.shop.entity.Sorder">
        UPDATE zk_sorder
        SET name = #{name,jdbcType=VARCHAR},
            price = #{price,jdbcType=DOUBLE},
            number = #{number,jdbcType=INTEGER},
            fid = #{fid,jdbcType=INTEGER},
            pid = #{pid,jdbcType=INTEGER}
        WHERE sid = #{sid,jdbcType=INTEGER}
    </update>

</mapper>
