<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.mapper.ProductMapper">
    
    <!-- 商品实体结果映射 -->
    <resultMap id="ProductResultMap" type="com.shop.entity.Product">
        <id column="pid" jdbcType="INTEGER" property="pid"/>
        <result column="pname" jdbcType="VARCHAR" property="pname"/>
        <result column="sprice" jdbcType="DECIMAL" property="sprice"/>
        <result column="cprice" jdbcType="DECIMAL" property="cprice"/>
        <result column="pic" jdbcType="VARCHAR" property="pic"/>
        <result column="pdesc" jdbcType="VARCHAR" property="pdesc"/>
        <result column="is_hot" jdbcType="TINYINT" property="isHot"/>
        <result column="pdate" jdbcType="TIMESTAMP" property="pdate"/>
        <result column="number" jdbcType="INTEGER" property="number"/>
    </resultMap>

    <!-- 基础列名列表 -->
    <sql id="Base_Column_List">
        pid, pname, sprice, cprice, pic, pdesc, is_hot, pdate, number
    </sql>

    <!-- 根据主键查询商品 -->
    <select id="selectByPrimaryKey" parameterType="java.lang.Integer" resultMap="ProductResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM zk_product
        WHERE pid = #{pid,jdbcType=INTEGER}
    </select>

    <!-- 查询所有商品列表 -->
    <select id="listProduct" resultMap="ProductResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM zk_product
        ORDER BY pdate DESC
    </select>

    <!-- 根据商品名称模糊查询 -->
    <select id="findByPname" resultMap="ProductResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM zk_product
        WHERE pname LIKE CONCAT('%', #{value}, '%')
    </select>

    <!-- 查询最新上架商品（前10条） -->
    <select id="frontlistNew" resultMap="ProductResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM zk_product
        ORDER BY pdate DESC
        LIMIT 10
    </select>

    <!-- 查询热门商品（前5条） -->
    <select id="frontlistHot" resultMap="ProductResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM zk_product
        WHERE is_hot = 1
        LIMIT 5
    </select>

    <!-- 根据主键删除商品 -->
    <delete id="deleteByPrimaryKey" parameterType="java.lang.Integer">
        DELETE FROM zk_product
        WHERE pid = #{pid,jdbcType=INTEGER}
    </delete>

    <!-- 插入商品（全字段） -->
    <insert id="insert" parameterType="com.shop.entity.Product">
        INSERT INTO zk_product (pname, sprice, cprice, pic, pdesc, is_hot, pdate, number)
        VALUES (#{pname,jdbcType=VARCHAR}, #{sprice,jdbcType=DECIMAL}, #{cprice,jdbcType=DECIMAL},
                #{pic,jdbcType=VARCHAR}, #{pdesc,jdbcType=VARCHAR}, #{isHot,jdbcType=TINYINT},
                NOW(), #{number,jdbcType=INTEGER})
    </insert>

    <!-- 选择性插入商品（仅插入非空字段） -->
    <insert id="insertSelective" parameterType="com.shop.entity.Product">
        INSERT INTO zk_product
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="pid != null">pid,</if>
            <if test="pname != null">pname,</if>
            <if test="sprice != null">sprice,</if>
            <if test="cprice != null">cprice,</if>
            <if test="pic != null">pic,</if>
            <if test="pdesc != null">pdesc,</if>
            <if test="isHot != null">is_hot,</if>
            <if test="pdate != null">pdate,</if>
            <if test="number != null">number,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="pid != null">#{pid,jdbcType=INTEGER},</if>
            <if test="pname != null">#{pname,jdbcType=VARCHAR},</if>
            <if test="sprice != null">#{sprice,jdbcType=DECIMAL},</if>
            <if test="cprice != null">#{cprice,jdbcType=DECIMAL},</if>
            <if test="pic != null">#{pic,jdbcType=VARCHAR},</if>
            <if test="pdesc != null">#{pdesc,jdbcType=VARCHAR},</if>
            <if test="isHot != null">#{isHot,jdbcType=TINYINT},</if>
            <if test="pdate != null">#{pdate,jdbcType=TIMESTAMP},</if>
            <if test="number != null">#{number,jdbcType=INTEGER},</if>
        </trim>
    </insert>

    <!-- 选择性更新商品（仅更新非空字段） -->
    <update id="updateByPrimaryKeySelective" parameterType="com.shop.entity.Product">
        UPDATE zk_product
        <set>
            <if test="pname != null">pname = #{pname,jdbcType=VARCHAR},</if>
            <if test="sprice != null">sprice = #{sprice,jdbcType=DECIMAL},</if>
            <if test="cprice != null">cprice = #{cprice,jdbcType=DECIMAL},</if>
            <if test="pic != null">pic = #{pic,jdbcType=VARCHAR},</if>
            <if test="pdesc != null">pdesc = #{pdesc,jdbcType=VARCHAR},</if>
            <if test="isHot != null">is_hot = #{isHot,jdbcType=TINYINT},</if>
            <if test="pdate != null">pdate = #{pdate,jdbcType=TIMESTAMP},</if>
            <if test="number != null">number = #{number,jdbcType=INTEGER},</if>
        </set>
        WHERE pid = #{pid,jdbcType=INTEGER}
    </update>

    <!-- 根据主键更新商品（全字段） -->
    <update id="updateByPrimaryKey" parameterType="com.shop.entity.Product">
        UPDATE zk_product
        SET pname = #{pname,jdbcType=VARCHAR},
            sprice = #{sprice,jdbcType=DECIMAL},
            cprice = #{cprice,jdbcType=DECIMAL},
            pic = #{pic,jdbcType=VARCHAR},
            pdesc = #{pdesc,jdbcType=VARCHAR},
            is_hot = #{isHot,jdbcType=TINYINT},
            number = #{number,jdbcType=INTEGER}
        WHERE pid = #{pid,jdbcType=INTEGER}
    </update>

    <!-- 批量扣减商品库存 -->
    <update id="subProductNumber" parameterType="java.util.Set">
        <foreach collection="list" item="item" index="index" separator=";">
            UPDATE zk_product
            SET number = number - #{item.number}
            WHERE pid = #{item.pid} AND number >= #{item.number}
        </foreach>
    </update>

</mapper>
