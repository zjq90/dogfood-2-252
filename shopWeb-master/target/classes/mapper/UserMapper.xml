<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.mapper.UserMapper">
    
    <!--
        用户数据访问层映射文件
        对应数据库表 zk_user
        提供用户的增删改查操作
    -->
    
    <!-- 用户结果映射 -->
    <resultMap id="BaseResultMap" type="com.shop.entity.User">
        <id column="uid" jdbcType="INTEGER" property="uid"/>
        <result column="username" jdbcType="VARCHAR" property="username"/>
        <result column="password" jdbcType="VARCHAR" property="password"/>
        <result column="realname" jdbcType="VARCHAR" property="realname"/>
        <result column="email" jdbcType="VARCHAR" property="email"/>
        <result column="phone" jdbcType="VARCHAR" property="phone"/>
        <result column="addr" jdbcType="VARCHAR" property="addr"/>
    </resultMap>

    <!-- 基础列列表 -->
    <sql id="Base_Column_List">
        uid, username, password, realname, email, phone, addr
    </sql>

    <!--
        根据主键查询用户
        @param uid 用户ID
        @return 用户信息
    -->
    <select id="selectByPrimaryKey" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM zk_user
        WHERE uid = #{uid,jdbcType=INTEGER}
    </select>

    <!--
        检查用户名是否存在
        @param username 用户名
        @return 存在返回1，不存在返回0
    -->
    <select id="checkUsername" parameterType="java.lang.String" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM zk_user
        WHERE username = #{value}
    </select>

    <!--
        根据用户名和密码查询用户（登录验证）
        @param username 用户名
        @param password 密码
        @return 用户信息
    -->
    <select id="findByUsernameAndPassword" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM zk_user
        WHERE username = #{username} AND password = #{password}
    </select>

    <!--
        根据主键删除用户
        @param uid 用户ID
        @return 影响的行数
    -->
    <delete id="deleteByPrimaryKey" parameterType="java.lang.Integer">
        DELETE FROM zk_user
        WHERE uid = #{uid,jdbcType=INTEGER}
    </delete>

    <!--
        插入用户信息
        @param user 用户信息
        @return 影响的行数
    -->
    <insert id="insert" parameterType="com.shop.entity.User" useGeneratedKeys="true" keyProperty="uid">
        INSERT INTO zk_user (username, password, realname, email, phone, addr)
        VALUES (#{username,jdbcType=VARCHAR}, #{password,jdbcType=VARCHAR},
                #{realname,jdbcType=VARCHAR}, #{email,jdbcType=VARCHAR}, 
                #{phone,jdbcType=VARCHAR}, #{addr,jdbcType=VARCHAR})
    </insert>

    <!--
        选择性插入用户信息
        只插入非空字段
        @param user 用户信息
        @return 影响的行数
    -->
    <insert id="insertSelective" parameterType="com.shop.entity.User" useGeneratedKeys="true" keyProperty="uid">
        INSERT INTO zk_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="username != null">username,</if>
            <if test="password != null">password,</if>
            <if test="realname != null">realname,</if>
            <if test="email != null">email,</if>
            <if test="phone != null">phone,</if>
            <if test="addr != null">addr,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="username != null">#{username,jdbcType=VARCHAR},</if>
            <if test="password != null">#{password,jdbcType=VARCHAR},</if>
            <if test="realname != null">#{realname,jdbcType=VARCHAR},</if>
            <if test="email != null">#{email,jdbcType=VARCHAR},</if>
            <if test="phone != null">#{phone,jdbcType=VARCHAR},</if>
            <if test="addr != null">#{addr,jdbcType=VARCHAR},</if>
        </trim>
    </insert>

    <!--
        根据主键选择性更新用户信息
        只更新非空字段
        @param user 用户信息
        @return 影响的行数
    -->
    <update id="updateByPrimaryKeySelective" parameterType="com.shop.entity.User">
        UPDATE zk_user
        <set>
            <if test="username != null">username = #{username,jdbcType=VARCHAR},</if>
            <if test="password != null">password = #{password,jdbcType=VARCHAR},</if>
            <if test="realname != null">realname = #{realname,jdbcType=VARCHAR},</if>
            <if test="email != null">email = #{email,jdbcType=VARCHAR},</if>
            <if test="phone != null">phone = #{phone,jdbcType=VARCHAR},</if>
            <if test="addr != null">addr = #{addr,jdbcType=VARCHAR},</if>
        </set>
        WHERE uid = #{uid,jdbcType=INTEGER}
    </update>

    <!--
        根据主键更新用户信息
        更新所有字段
        @param user 用户信息
        @return 影响的行数
    -->
    <update id="updateByPrimaryKey" parameterType="com.shop.entity.User">
        UPDATE zk_user
        SET username = #{username,jdbcType=VARCHAR},
            password = #{password,jdbcType=VARCHAR},
            realname = #{realname,jdbcType=VARCHAR},
            email = #{email,jdbcType=VARCHAR},
            phone = #{phone,jdbcType=VARCHAR},
            addr = #{addr,jdbcType=VARCHAR}
        WHERE uid = #{uid,jdbcType=INTEGER}
    </update>

</mapper>
